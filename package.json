{
  "name": "pi-subagents",
  "version": "0.4.11",
  "description": "SDK-native background subagents for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "async"
  ],
  "license": "MIT",
  "author": "Bukutsu",
  "files": [
    "index.ts",
    "src/**/*",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -p tsconfig.json && prettier --check .",
    "test": "bun test",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bukutsu/pi-subagents.git"
  },
  "homepage": "https://github.com/Bukutsu/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/Bukutsu/pi-subagents/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
